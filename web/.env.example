# Copy to .env.local for `npm run dev`; on Vercel, add these under Settings → Environment Variables.

# The service console reads Salesforce through the Node server's /api/admin with its INTERNAL_API_KEY.
NODE_API_URL=https://tiffany-designs-customer-service.onrender.com
NODE_API_KEY=

# The console's staff sign-in. SESSION_SECRET signs the sign-in cookie: 32 random characters or more.
ADMIN_EMAIL=admin@tiffanydesigns.in
ADMIN_PASSWORD=
SESSION_SECRET=

# Required: the Sarvam workspace API key (Sarvam agents dashboard → Settings → API keys), without quotes.
SARVAM_API_KEY=

# Optional: the committed agent version web calls use (default: Sarvam's current version).
SARVAM_APP_VERSION=3

# Optional: shared rate-limit counts. Connecting Upstash Redis in Vercel (Storage) sets these;
# without them, each server instance counts on its own.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: overall caps on browser calls across all visitors (each visitor also gets 5 per 10 minutes and 20 per day).
WEB_CALLS_MAX_PER_HOUR=30
WEB_CALLS_MAX_PER_DAY=200

# Optional: use another server's /api/sarvam/ instead of this site's own (for example the Node server on Render).
NEXT_PUBLIC_VOICE_SERVER_URL=
