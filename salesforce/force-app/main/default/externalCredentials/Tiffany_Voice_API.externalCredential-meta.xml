<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Authenticates Salesforce to the Tiffany voice server. The apiKey principal parameter holds SITE_CALL_API_KEY and is set by scripts/deploy-salesforce.js, never committed.</description>
    <externalCredentialParameters>
        <parameterGroup>main</parameterGroup>
        <parameterName>main</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>x-api-key</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.Tiffany_Voice_API.apiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Tiffany Voice API</label>
</ExternalCredential>
