PORT=8081

# Salesforce (External Client App, Client Credentials flow)
SF_LOGIN_URL=https://<your-domain>.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Account record type (developer name) for new callers; empty uses the org default
SF_CUSTOMER_ACCOUNT_RECORD_TYPE=
# Only standard price book products whose code starts with this can be ordered by phone; empty allows all
PRODUCT_CODE_PREFIX=TD-

# Sarvam Samvaad: the only agent this project is allowed to change
SARVAM_ORG_ID=01a0c3a4-b74a-7441-813a-d7d799923769
SARVAM_WORKSPACE_ID=01a0c3ef-4753-7a81-a20c-07f739dcf1d6
SARVAM_AGENT_ID=Tiffany-Des-0db8e21d-e099
SARVAM_AGENT_NAME=Tiffany Designs Customer Service
SARVAM_AGENT_URL=https://indus.sarvam.ai/samvaad/build/update-agent/Tiffany-Des-0db8e21d-e099
# Workspace API key from the Sarvam agents dashboard (Settings → API keys), starting with sk_samvaad_.
# A speech-API key is refused. Server only: never put it in a web page.
SARVAM_API_KEY=

# Server (on Vercel, PUBLIC_BASE_URL defaults to the production domain; on Render, set it to the service URL)
PUBLIC_BASE_URL=
INTERNAL_API_KEY=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/jobs
CRON_SECRET=
# Used by Salesforce for the website "call me" panel; it can only request calls
SITE_CALL_API_KEY=
AGENT_TOOL_SECRET=
SARVAM_WEBHOOK_TOKEN=

# Instant calls (website "call me" panel)
SARVAM_APP_VERSION=3
SARVAM_CONNECTION_ID=400d8d12-e7-71c06c76-7673
# Tiffany's own number; +917965851546 is deployed to another agent (test calls only)
SARVAM_AGENT_PHONE=
# "registered" only calls numbers on a Salesforce contact; "any" calls any Indian mobile
CALLBACK_ALLOWED_NUMBERS=any
CALLBACK_MAX_PER_HOUR=20
CALLBACK_MAX_PER_DAY=100

# Browser calls from the web widget (public/test.html), across all visitors; each visitor also gets 5 per 10 minutes
WEB_CALLS_MAX_PER_HOUR=30
WEB_CALLS_MAX_PER_DAY=200
# Websites allowed to host the widget, comma-separated (for example https://www.tiffanydesigns.in); * allows any site
WEB_CALL_ALLOWED_ORIGINS=*

# Sarvam campaigns (scheduled calls)
SARVAM_FOLLOWUP_CAMPAIGN_ID=
SARVAM_CALLBACK_CAMPAIGN_ID=
SARVAM_NOTIFY_CAMPAIGN_ID=

# Scheduling (business hours come from Salesforce "Tiffany Support Hours")
FOLLOWUP_DELAY_MINUTES=60

# Shared store for scheduled calls and callback limits (required on Vercel; locally a file and memory are used).
# The Vercel Upstash integration may name these KV_REST_API_URL and KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=tiffany:
